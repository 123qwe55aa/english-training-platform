# Copy to .env and replace every example value before starting the app.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
APP_PORT=8080
# Optional public TLS profile: set your real domain, then run with --profile public.
SITE_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
# Optional package mirror for image builds.
BUILD_PIP_INDEX_URL=https://pypi.org/simple
